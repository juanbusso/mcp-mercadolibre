{
  "name": "mcp-mercadolibre",
  "version": "1.2.0",
  "description": "Servidor Model Context Protocol (MCP) para Mercado Libre Argentina. Búsqueda con evasión antibot, filtros Full/Internacional, carrito y checkout directo.",
  "main": "build/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/YOUR_GITHUB_USER/mcp-mercadolibre.git"
  },
  "author": "mcp-mercadolibre contributors",
  "type": "module",
  "license": "MIT",
  "bin": "./build/main.js",
  "files": [
    "build"
  ],
  "keywords": [
    "mcp",
    "mercadolibre",
    "model-context-protocol",
    "agent",
    "shopping",
    "argentina"
  ],
  "scripts": {
    "start": "node build/main.js",
    "start:dev": "tsx watch src/main.ts",
    "build": "tsc && chmod 755 build/main.js",
    "ts:check": "tsc --noEmit",
    "lint": "biome check"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "cheerio": "^1.2.0",
    "dayjs": "^1.11.21",
    "domhandler": "^6.0.1",
    "voca": "^1.4.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/node": "^26.1.2",
    "@types/voca": "^1.4.6",
    "prettier": "^3.9.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@hono/node-server": "^2.0.12"
  }
}
