# Mercado Libre MCP Server - Configuration (Optional)
# Searching products (buscar-productos) does NOT require any session or cookies.
# Cart actions (agregar-al-carrito, eliminar-del-carrito, resumen-carrito) require session cookies.

# Option 1: Set via environment variables
MELI_SSID=""
MELI_CP="1000"
MELI_CSRF=""

# Or pass a full cookie string:
# MELI_COOKIE="ssid=...; cp=...; _csrf=..."

# Option 2: Place a JSON file in ~/.config/mcp-mercadolibre/session.json
# {
#   "ssid": "...",
#   "cp": "1000",
#   "_csrf": "..."
# }
